{
  "uid": "shoowcase-http",
  "title": "Shoowcase / HTTP traffic",
  "description": "Throughput, server failures and latency across the control and content surfaces. Select instances to isolate a replica.",
  "tags": [
    "shoowcase",
    "opentelemetry",
    "http"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "Shoowcase dashboards",
      "tags": [
        "shoowcase"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "shoowcase-prometheus"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\"}, job)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\"}, job)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": "shoowcase",
          "value": "shoowcase"
        },
        "refresh": 1,
        "sort": 1,
        "options": [],
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "skipUrlSync": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "shoowcase-prometheus"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\"}, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "options": [],
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "skipUrlSync": false,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "description": "Completed or interrupted requests per second across the selection.",
      "datasource": {
        "type": "prometheus",
        "uid": "shoowcase-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shoowcase-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server failure share",
      "description": "Percentage of requests that returned HTTP 5xx or ended before a response status was recorded. No traffic leaves this value empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "shoowcase-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shoowcase-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * ((sum(rate(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\",error_type=~\"5[0-9][0-9]|interrupted\"}[$__rate_interval])) or (0 * sum(rate(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])))) / (sum(rate(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])) > 0))",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No traffic",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 2,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request latency · p95",
      "description": "95th percentile of request duration across all selected instances, calculated from the combined histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "shoowcase-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shoowcase-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]))) and on () (sum(rate(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])) > 0)",
          "legendFormat": "__auto",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No traffic",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Responses by status",
      "description": "Request rate by HTTP response code. Interrupted requests have no response code and appear as a separate series.",
      "datasource": {
        "type": "prometheus",
        "uid": "shoowcase-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shoowcase-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (http_response_status_code) (label_replace(rate(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]), \"http_response_status_code\", \"$1\", \"error_type\", \"(interrupted)\"))",
          "legendFormat": "{{http_response_status_code}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 9,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request latency by surface · p95",
      "description": "95th percentile for each surface. A gap means the surface handled no requests in the rate window.",
      "datasource": {
        "type": "prometheus",
        "uid": "shoowcase-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shoowcase-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, shoowcase_surface) (rate(http_server_request_duration_seconds_bucket{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval]))) and on (shoowcase_surface) (sum by (shoowcase_surface) (rate(http_server_request_duration_seconds_count{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{shoowcase_surface}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 9,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "In-flight requests by surface",
      "description": "Concurrent requests at scrape time. Short requests can finish between samples.",
      "datasource": {
        "type": "prometheus",
        "uid": "shoowcase-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shoowcase-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (shoowcase_surface) (http_server_active_requests{otel_scope_name=\"github.com/openhoo/shoowcase\",job=~\"${service:regex}\",instance=~\"${instance:regex}\"})",
          "legendFormat": "{{shoowcase_surface}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 9,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
